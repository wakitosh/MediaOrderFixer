<script>
document.addEventListener('DOMContentLoaded', function () {
  var toggleButton = document.getElementById('mof-toggle-select');
  if (!toggleButton) {
    return;
  }

  var allCheckboxes = Array.prototype.slice.call(
    document.querySelectorAll('input[name="selected_item_ids[]"]')
  );
  var eligibleCheckboxes = allCheckboxes.filter(function (checkbox) {
    return !checkbox.disabled;
  });

  if (!eligibleCheckboxes.length) {
    toggleButton.disabled = true;
    return;
  }

  var selectAllText = <?= json_encode((string) $translate('Select All')) ?>;
  var deselectAllText = <?= json_encode((string) $translate('Deselect All')) ?>;

  var updateToggleLabel = function () {
    var allChecked = eligibleCheckboxes.every(function (checkbox) {
      return checkbox.checked;
    });
    var label = allChecked ? deselectAllText : selectAllText;
    toggleButton.setAttribute('title', label);
    toggleButton.setAttribute('aria-label', label);
  };

  toggleButton.addEventListener('click', function () {
    var allChecked = eligibleCheckboxes.every(function (checkbox) {
      return checkbox.checked;
    });
    var nextState = !allChecked;
    eligibleCheckboxes.forEach(function (checkbox) {
      checkbox.checked = nextState;
    });
    updateToggleLabel();
  });

  eligibleCheckboxes.forEach(function (checkbox) {
    checkbox.addEventListener('change', updateToggleLabel);
  });

  updateToggleLabel();
});
</script>
